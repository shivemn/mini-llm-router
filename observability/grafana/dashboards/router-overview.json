{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (route) (rate(mini_router_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Request latency p50 / p95",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, route) (rate(mini_router_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{route}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(mini_router_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{route}}", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "HTTP responses by status",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (status) (rate(mini_router_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "5xx response rate",
      "type": "timeseries",
      "targets": [{ "expr": "100 * sum(rate(mini_router_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(mini_router_http_requests_total[5m])), 0.000001)", "legendFormat": "5xx %", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "title": "Upstream requests and errors",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (provider) (rate(mini_router_provider_requests_total[5m]))", "legendFormat": "requests {{provider}}", "refId": "A" },
        { "expr": "sum by (provider) (rate(mini_router_provider_errors_total[5m]))", "legendFormat": "errors {{provider}}", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "title": "Average upstream latency",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (provider) (rate(mini_router_provider_latency_ms_total[5m])) / clamp_min(sum by (provider) (rate(mini_router_provider_requests_total[5m])), 0.000001)", "legendFormat": "{{provider}}", "refId": "A" }]
    }
  ],
