# Copy this file to .env and fill in your provider settings.
# Client model names (for example, fast) map to upstream model IDs.
PROVIDERS_JSON={"openai":{"baseUrl":"https://api.openai.com/v1","apiKey":"replace-me","models":{"fast":"gpt-4o-mini"}}}

# Legacy single-provider settings are still supported when PROVIDERS_JSON is unset.
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=replace-me
# UPSTREAM_MODEL=gpt-4o-mini

# Optional: require callers to send this key as Authorization: Bearer <key>.
# Keep the server bound to localhost unless you add proper network security.
ROUTER_API_KEY=

# Optional. Defaults to 127.0.0.1:3001.
HOST=127.0.0.1
PORT=3001

# Retry temporary upstream failures at most this many times (0-5, default 1).
MAX_UPSTREAM_RETRIES=1
