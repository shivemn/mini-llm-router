# Copy this file to .env and fill in your provider settings.
# Client model names (for example, fast) map to upstream model IDs.
# Prefer apiKeySecretId in AWS Secrets Manager. Plain apiKey remains available for local mocks.
PROVIDERS_JSON={"openai":{"protocol":"openai-compatible","baseUrl":"https://api.openai.com/v1","apiKeySecretId":"mini-llm-router/openai","models":{"fast":"gpt-4o-mini"}}}
# Anthropic: {"protocol":"anthropic","baseUrl":"https://api.anthropic.com","apiKeySecretId":"mini-llm-router/anthropic","models":{"claude":"your-claude-model-id"}}
# Gemini: {"protocol":"gemini","baseUrl":"https://generativelanguage.googleapis.com/v1beta","apiKeySecretId":"mini-llm-router/gemini","models":{"gemini":"your-gemini-model-id"}}
AWS_REGION=us-east-1
AWS_PROFILE=mini-router
AWS_SDK_LOAD_CONFIG=1

# Legacy single-provider settings are still supported when PROVIDERS_JSON is unset.
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=replace-me
# UPSTREAM_MODEL=gpt-4o-mini

# Optional: require callers to send this key as Authorization: Bearer <key>.
# Keep the server bound to localhost unless you add proper network security.
ROUTER_API_KEY=

# Optional. Defaults to 127.0.0.1:3001.
HOST=127.0.0.1
PORT=3001

# Retry temporary upstream failures at most this many times (0-5, default 0).
MAX_UPSTREAM_RETRIES=0

# Maximum in-flight chat requests (1-1000, default 100).
MAX_CONCURRENT_REQUESTS=100

# Open a provider circuit after this many failed provider attempts (1-20, default 3).
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# Keep an open provider circuit paused for this many milliseconds (1000-300000, default 30000).
CIRCUIT_BREAKER_OPEN_MS=30000

# Per-router-key (or source-IP) fixed-window request limit.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Optional OpenTelemetry OTLP trace export. Leave the endpoint blank to disable tracing.
OTEL_SERVICE_NAME=mini-llm-router
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer-your-collector-token

# Optional Redis shared state. Docker Compose sets this to its Redis service automatically.
REDIS_URL=
REDIS_KEY_PREFIX=mini-llm-router

# Optional Grafana login password for the local Docker Compose stack.
GRAFANA_ADMIN_PASSWORD=change-this-password
